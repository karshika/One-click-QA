# ---- Mistral AI (free "Experiment" plan works; get a key at https://console.mistral.ai) ----
# Leave empty to run fully deterministic (no AI planning/prose; template tests only).
MISTRAL_API_KEY=

# Model names (check https://docs.mistral.ai/getting-started/models/ - names change over time)
MISTRAL_MODEL_PLANNER=mistral-large-latest   # journey planning + failure analysis
MISTRAL_MODEL_CODE=codestral-latest          # Playwright test generation + repair
MISTRAL_MODEL_FAST=mistral-small-latest      # executive summary / report prose
MISTRAL_MODEL_VISION=mistral-large-latest    # optional screenshot checks (ENABLE_VISION_CHECK)

# Free-tier survival
MISTRAL_RPS=1                 # max requests per second (process-wide token bucket)
MISTRAL_TPM=400000            # max tokens per minute (process-wide)
MISTRAL_MAX_RETRIES=5         # retries on 429/5xx with exponential backoff + jitter
MAX_LLM_CALLS_PER_RUN=60      # per-run budget; afterwards stages fall back to deterministic output
MAX_LLM_CALLS_PER_DAY=500     # per-day budget across all runs
LLM_TEMPERATURE=0.1
ENABLE_VISION_CHECK=false     # experimental, off by default

# ---- App ----
# Fernet key for encrypting stored login credentials. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is generated once into $OCQA_DATA_DIR/.secret_key
OCQA_SECRET_KEY=
# OCQA_DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/oneclickqa.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Security ----
ALLOW_LOCAL_TARGETS=false     # set true to test localhost / private-network apps (e.g. the demo app)
EXTRA_ALLOWED_DOMAINS=        # comma-separated extra domains the crawler may visit

# ---- Run defaults ----
DEFAULT_MAX_PAGES=15
DEFAULT_MAX_DEPTH=3
REQUEST_DELAY_MS=250
MAX_JOURNEYS=6
TEST_TIMEOUT_S=60
PERF_RUNS_PER_PAGE=3
